# Server Configuration
PORT=8000
HOST="127.0.0.1"

# LocalAI Endpoints & Model Configuration
LOCALAI_BASE_URL="http://localhost:8080/v1"
TEXT_MODEL_NAME="Qwen3.5-9B"
IMAGE_MODEL_NAME="sd-1.5-ggml"
TARGET_LANGUAGE="English"
EXPORT_DECK_NAME="MyDeck"

# Genanki Output Settings
# The local directory path where generated images and .apkg files are saved
OUTPUT_DIR="./exports"

# Batch Storage
# SQLite file holding the current batch and its cards
DB_FILE="./temporary_batch.db"
# Hours a batch is kept after its first download
RETENTION_HOURS=24

# Generation
# Set to false to skip image generation
GENERATE_IMAGES=true
# Parallel AI requests; keep at 1 for a single local model
GENERATION_CONCURRENCY=1

# Limits
MAX_WORDS_PER_REQUEST=100
MAX_CARDS_PER_BATCH=300
MAX_UPLOAD_BYTES=1000000